# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser or commit it.
# Used only in admin/server code that needs to bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Also required: in Supabase → Authentication → URL Configuration, add
# http://localhost:3000/auth/callback (and your production URL's
# equivalent) to "Redirect URLs", or magic-link sign-in will fail silently.
